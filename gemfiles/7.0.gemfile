source 'https://rubygems.org'

gem 'bootsnap' # required to run `rake test` in Rails 7.0
gem 'bundler', '~>2'
gem 'concurrent-ruby', '< 1.3.5' # 1.3.5 dropped require 'logger', which Rails < 7.1 relies on
gem 'minitest', '< 6' # railties 7.0 is incompatible with minitest 6
gem 'rails', '~>7.0.0'
gem 'sprockets-rails'
gem 'rdoc'
gem 'sprockets', '~>3.0'
gem 'sqlite3', '~> 1.4'

gemspec :path => '../'
