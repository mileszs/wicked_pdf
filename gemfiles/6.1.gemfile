source 'https://rubygems.org'

gem 'bootsnap' # required to run `rake test` in Rails 6.1
gem 'bundler', '~>2'
gem 'concurrent-ruby', '< 1.3.5' # 1.3.5 dropped require 'logger', which Rails < 7.1 relies on
gem 'rails', '~>6.1.0'
gem 'webpacker'
gem 'rdoc'
gem 'sprockets', '~>3.0'
gem 'sqlite3', '~> 1.4'

gemspec :path => '../'
